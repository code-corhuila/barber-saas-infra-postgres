# Names and placeholders only (Annex J J.5.1). Copy to env/main.env, which git ignores, and fill it in.
# Each environment has its own project name, so its own containers and volume.
COMPOSE_PROJECT_NAME=barber-saas-main

# Single PostgreSQL instance (ADR-011). The administrator is used only by the infrastructure
# and by the -db migration runners; services connect as <domain>_app.
PG_DATABASE=barbersaas
PG_ADMIN_USER=barbersaas_admin
PG_ADMIN_PASSWORD=

# One password per domain user, created by postgres/init/01-instance.sh
IDENTITY_AUTH_APP_PASSWORD=
BARBERSHOP_APP_PASSWORD=
SCHEDULE_APP_PASSWORD=
APPOINTMENT_APP_PASSWORD=
LOYALTY_APP_PASSWORD=
FINANCE_INVENTORY_APP_PASSWORD=
PLATFORM_ADMIN_APP_PASSWORD=
WORKFLOW_APP_PASSWORD=

# Single MongoDB instance (barber-saas-infra-mongo, ADR-011). Same rules: the administrator only
# for the infrastructure and the -db runners; services connect as <domain>_app.
MONGO_ADMIN_USER=barbersaas_admin
MONGO_ADMIN_PASSWORD=
# Shared secret of the replica set (any long random string, e.g. openssl rand -base64 48).
MONGO_REPLICA_KEY=
NOTIFICATIONS_APP_PASSWORD=
# Push (FCM HTTP v1) for notifications-api: the service account JSON of your Firebase project, in
# one line. Empty: no push, notices stay in the inbox. A personal secret: never commit or share it.
FCM_SERVICE_ACCOUNT_JSON=
# E-mail (SMTP) for notifications-api: the 6-digit codes (password reset, e-mail verification, ADR-018),
# the plan notices and the reminders (DEC-NOTIF-02). Without it nobody can verify an account.
# Empty SMTP_HOST: the code is not e-mailed and waits in the outbox. With Gmail, SMTP_PASSWORD is an
# app password of the sending account (2-step verification on). A personal secret: never commit it.
# SMTP_SECURITY=none is only for a local test server and is refused together with SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BarberSaaS <no-reply@example.com>

# Identity: issued by identity-auth and injected as environment secrets, never dev keys (norm 5.9.2).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# One token per calling service; its `sub` is the service name (07-api/authentication.md).
WORKFLOW_SERVICE_TOKEN=
WORKER_SERVICE_TOKEN=
# barbershop-api reads users from identity-auth (ADR-014); schedule-api reads busy slots (ADR-015);
# platform-admin-api operates barbershops through barbershop-api (DEC-SHOP-06).
BARBERSHOP_SERVICE_TOKEN=
SCHEDULE_SERVICE_TOKEN=
PLATFORM_ADMIN_SERVICE_TOKEN=
# appointment-api reads the reviewer's name (DEC-APPT-11); notifications-api a client's e-mail (DEC-NOTIF-02).
APPOINTMENT_SERVICE_TOKEN=
NOTIFICATIONS_SERVICE_TOKEN=

# The public name of the host (ADR-019): Caddy gets its HTTPS certificate for it (compose.public.yml).
PUBLIC_HOST=

# Wompi in SANDBOX (ADR-017): pub_test_ key and the test secrets of the team's Wompi account. Never real
# keys. In Wompi's dashboard, the events URL is https://<PUBLIC_HOST>/api/v1/payments/wompi/events.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=

# The one-hour reminder of the worker (DEC-APPT-12), in seconds; empty = off. Only with an appointment-api
# that takes `window` (HU-NOTIF-005), or it would send the day-before reminders early.
WORKER_HOUR_REMINDERS_EVERY_SECONDS=300
