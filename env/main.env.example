# Names and placeholders only (Annex J J.5.1). Copy to env/main.env, which git ignores, and fill it in.
# Each environment has its own project name, so its own containers and volume.
COMPOSE_PROJECT_NAME=barber-saas-main

# Single PostgreSQL instance (ADR-011). The administrator is used only by the infrastructure
# and by the -db migration runners; services connect as <domain>_app.
PG_DATABASE=barbersaas
PG_ADMIN_USER=barbersaas_admin
PG_ADMIN_PASSWORD=

# One password per domain user, created by postgres/init/01-instance.sh
IDENTITY_AUTH_APP_PASSWORD=
BARBERSHOP_APP_PASSWORD=
SCHEDULE_APP_PASSWORD=
APPOINTMENT_APP_PASSWORD=
LOYALTY_APP_PASSWORD=
FINANCE_INVENTORY_APP_PASSWORD=
PLATFORM_ADMIN_APP_PASSWORD=
WORKFLOW_APP_PASSWORD=

# Identity: issued by identity-auth and injected as environment secrets, never dev keys (norm 5.9.2).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# One token per calling service; its `sub` is the service name (07-api/authentication.md).
WORKFLOW_SERVICE_TOKEN=
WORKER_SERVICE_TOKEN=
